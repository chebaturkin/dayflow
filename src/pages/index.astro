---
import '../styles/global.css';
---
<html lang="ru"><head><meta charset="utf-8" /><meta name="viewport" content="width=device-width" /><title>dayflow</title></head>
<body><main class="shell">
<header class="topbar"><a class="wordmark" href="/">dayflow</a><nav><a href="#export">экспорт</a><button id="theme" aria-label="сменить тему">тёмная тема</button></nav></header>
<section class="intro"><div><p class="date-context">6 октября 2026</p><h1>расписание на день</h1><p class="lede">добавляйте занятия, отмечайте изменения и сохраняйте карточку</p></div></section>
<div class="layout"><section class="planner"><div class="section-head"><h2>занятия</h2><button id="add" class="text-action">добавить занятие <span>→</span></button></div><div id="lessons"></div></section>
<aside class="export" id="export"><div class="export-head"><h2>итог дня</h2><span class="count" id="count">0</span></div><div id="card-lessons" class="card-list"></div><div class="export-options"><p class="option-label">вид карточки</p><div class="styles" role="group" aria-label="вид карточки"><button data-style="clean" class="style active">лист</button><button data-style="dark" class="style">тёмная</button><button data-style="lines" class="style">линии</button></div><label class="check"><input id="repo" type="checkbox" checked /> добавить ссылку на репозиторий</label></div><button id="png" class="primary">сохранить карточку</button><p class="hint">файл создаётся на вашем устройстве</p></aside></div></main>
<script>
  // @ts-nocheck
  import { lessonToIcs } from '../lib/ics';
  type Status='planned'|'moved'|'cancelled'; type Lesson={id:string;title:string;start:string;end:string;status:Status};
  const fallback:Lesson[]=[{id:'design',title:'design systems',start:'09:00',end:'10:30',status:'planned'},{id:'english',title:'english practice',start:'11:40',end:'13:10',status:'cancelled'},{id:'studio',title:'studio practice',start:'13:40',end:'15:10',status:'moved'}];
  let lessons:Lesson[]=JSON.parse(localStorage.getItem('dayflow-lessons')||'null')||fallback; let style='clean';
  const root=document.querySelector('#lessons'),card=document.querySelector('#card-lessons'),count=document.querySelector('#count'); const save=()=>localStorage.setItem('dayflow-lessons',JSON.stringify(lessons));
  const download=(data,name,type)=>{const a=document.createElement('a');a.href=URL.createObjectURL(new Blob([data],{type}));a.download=name;a.click();URL.revokeObjectURL(a.href)};
  const renderCard=()=>{const active=lessons.filter(l=>l.status!=='cancelled'); count.textContent=String(active.length); card.innerHTML=(active.map(l=>`<div class="card-line"><time>${l.start}</time><span>${l.title}</span></div>`).join('')||'<p class="empty">нет занятий</p>')+(document.querySelector('#repo').checked?'<p class="repo-link">github.com/chebaturkin/dayflow</p>':''); card.parentElement.dataset.style=style};
  const render=()=>{lessons.sort((a,b)=>a.start.localeCompare(b.start));root.innerHTML='';lessons.forEach((l,i)=>{const row=document.createElement('article');row.className=`lesson ${l.status}`;row.innerHTML=`<time>${l.start}<small>${l.end}</small></time><input aria-label="название занятия" value="${l.title}"><select aria-label="статус занятия"><option value="planned">по плану</option><option value="moved">перенесли</option><option value="cancelled">отменили</option></select><button class="ics" aria-label="скачать календарь">календарь</button><button class="remove" aria-label="удалить">×</button>`;const input=row.querySelector('input'),select=row.querySelector('select');select.value=l.status;input.oninput=()=>{l.title=input.value;save();renderCard()};select.onchange=()=>{l.status=select.value;save();render()};row.querySelector('.remove').onclick=()=>{lessons.splice(i,1);save();render()};row.querySelector('.ics').onclick=()=>download(lessonToIcs('2026-10-06',l),`${l.title}.ics`,'text/calendar');root.append(row)});renderCard()};
  document.querySelector('#add').onclick=()=>{lessons.push({id:crypto.randomUUID(),title:'новое занятие',start:'16:00',end:'17:30',status:'planned'});save();render()}; document.querySelector('#theme').onclick=()=>document.documentElement.classList.toggle('dark'); document.querySelector('#repo').onchange=renderCard;
  document.querySelectorAll('.style').forEach(button=>button.onclick=()=>{style=button.dataset.style;document.querySelectorAll('.style').forEach(item=>item.classList.toggle('active',item===button));renderCard()});
  document.querySelector('#png').onclick=()=>{const canvas=document.createElement('canvas');canvas.width=1600;canvas.height=2000;const x=canvas.getContext('2d'),dark=style==='dark';x.fillStyle=dark?'#17221e':'#f7f7f2';x.fillRect(0,0,1600,2000);x.fillStyle=dark?'#f7f7f2':'#17221e';x.font='600 92px system-ui';x.fillText('расписание',120,220);x.font='400 38px system-ui';x.fillStyle=dark?'#b5c2b9':'#65716b';x.fillText('6 октября 2026',120,300);let y=480;lessons.filter(l=>l.status!=='cancelled').forEach(l=>{x.strokeStyle=dark?'#44584b':'#d4dbd5';x.beginPath();x.moveTo(120,y+42);x.lineTo(1480,y+42);x.stroke();x.fillStyle=dark?'#a7e0ba':'#157a52';x.font='400 36px monospace';x.fillText(l.start,120,y);x.fillStyle=dark?'#f7f7f2':'#17221e';x.font='500 56px system-ui';x.fillText(l.title,390,y);y+=170});if(document.querySelector('#repo').checked){x.fillStyle=dark?'#b5c2b9':'#65716b';x.font='400 26px monospace';x.fillText('github.com/chebaturkin/dayflow',120,1840)}canvas.toBlob(blob=>blob&&download(blob,'raspisanie-2026-10-06.png','image/png'),'image/png')}; render();
</script></body></html>
